<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1326"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/appTitle_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:fontFamily="@font/poppins_light"
        android:gravity="center"
        android:lineHeight="32dp"
        android:text="@string/card_clash_2p"
        android:textColor="#8aebff"
        android:textFontWeight="600"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/player_1_score_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:fontFamily="@font/poppins_light"
        android:lineHeight="24dp"
        android:text="Player 1: 0"
        android:textColor="#FFFFFF"
        android:textFontWeight="600"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appTitle_tv" />

    <TextView
        android:id="@+id/player_2_score_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:fontFamily="@font/poppins_light"
        android:lineHeight="24dp"
        android:text="Player 2: 0"
        android:textColor="#FFFFFF"
        android:textFontWeight="600"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appTitle_tv" />

    <TextView
        android:id="@+id/player_turns_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="48dp"
        android:fontFamily="@font/poppins_light"
        android:gravity="center"
        android:lineHeight="24dp"
        android:text="Player 1's Turn"
        android:textColor="#22D3EE"
        android:textFontWeight="600"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_1_score_tv" />

    <ImageView
        android:id="@+id/card1_iv"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_margin="24dp"
        android:src="@drawable/question_mark_card"
        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@id/player_turns_tv" />

    <ImageView
        android:id="@+id/card2_iv"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_margin="24dp"
        android:src="@drawable/question_mark_card"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toBottomOf="@id/player_turns_tv" />

    <Button
        android:id="@+id/draw_card_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:backgroundTint="#00BCD5"
        android:fontFamily="@font/poppins_light"
        android:text="Player 1: Draw Card"
        android:textColor="@color/black"
        android:textFontWeight="600"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card2_iv" />

    <TextView
        android:id="@+id/round_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ROUND"
        android:letterSpacing=".1"
        android:textFontWeight="200"
        android:textSize="32sp"
        android:textColor="#009FB4"
        android:fontFamily="@font/poppins_light"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/round_tv"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:id="@+id/round_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="1/5"
        android:letterSpacing=".1"
        android:textFontWeight="200"
        android:textSize="32sp"
        android:textColor="#F0F1F1"
        android:fontFamily="@font/poppins_light"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>