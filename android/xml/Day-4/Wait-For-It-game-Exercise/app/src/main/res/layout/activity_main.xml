<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1326"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="Wait For It!"
        android:textColor="#22D3EE"
        android:textSize="28sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#131B2E"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:strokeColor="#222A3D"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvPlayerTurn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PLAYER 1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCORE: 0"
                android:textColor="#45DA7D"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layoutLights"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btnTap"
        app:layout_constraintTop_toBottomOf="@id/cardScore">


        <androidx.cardview.widget.CardView
            android:id="@+id/light1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            app:cardBackgroundColor="#131B2E"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp" />


        <androidx.cardview.widget.CardView
            android:id="@+id/light2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            app:cardBackgroundColor="#131B2E"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp" />


        <androidx.cardview.widget.CardView
            android:id="@+id/light3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            app:cardBackgroundColor="#131B2E"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp" />


        <androidx.cardview.widget.CardView
            android:id="@+id/light4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            app:cardBackgroundColor="#131B2E"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp" />
    </LinearLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTap"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#22D3EE"
        android:fontFamily="sans-serif-black"
        android:text="TAP!"
        android:textColor="#0B1326"
        android:textSize="22sp"
        app:cornerRadius="32dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>