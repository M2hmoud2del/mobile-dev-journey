<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3A3D6"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="64dp"
        android:src="@drawable/tree" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/joan_title"
        android:shadowColor="#40000000"
        android:shadowDy="7"
        android:shadowRadius="4"
        android:text="Jacaranda"
        android:textColor="#FFF9F9"
        android:textSize="40sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:autoLink="web|phone"
        android:fontFamily="@font/goudy_details"
        android:text="Known as the purple rain tree, Jacaranda mimosifolia stuns with cascading violet blooms and fern-like leaves, making it one of the most beloved ornamental trees in the world. For more information about this remarkable tree, you can visit \nhttps://en.wikipedia.org/wiki/Jacaranda\n To order your Jacaranda, please call \n+201111111111."
        android:textColor="#FFF9F9"
        android:textColorLink="#8D14FF"
        android:textSize="20sp" />

</LinearLayout>